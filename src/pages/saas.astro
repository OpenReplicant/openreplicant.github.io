---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="SaaS | Open Replicant">
  <section class="hero">
    <div class="hero__content">
      <span class="badge badge--coming-soon">Coming soon</span>
      <h1>SaaS</h1>
      <p class="hero__tagline">
        A fully managed, hosted version of Morphogen is coming soon. Focus on
        building with self-managing infrastructure — we'll handle the hosting,
        updates, and ops.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="warning-banner">
      Not available yet — join the waitlist to be the first to know when it
      launches.
    </div>
    <h2>What to expect</h2>
    <div class="grid">
      <article class="card">
        <span class="card__accent" aria-hidden="true"></span>
        <h3>Managed hosting</h3>
        <p>
          We run Morphogen for you — infrastructure, updates, backups, and
          security handled. You build; we operate.
        </p>
      </article>
      <article class="card">
        <span class="card__accent" aria-hidden="true"></span>
        <h3>One-click start</h3>
        <p>
          Provision an instance in minutes and start describing systems without
          touching a terminal.
        </p>
      </article>
      <article class="card">
        <span class="card__accent" aria-hidden="true"></span>
        <h3>Open source at the core</h3>
        <p>
          The SaaS runs the same open source Morphogen. Export your knowledge
          kernel and self-host anytime — no lock-in, ever.
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="btn-row">
      <a href="mailto:waitlist@openreplicant.example" class="btn btn--large">Join the waitlist</a>
    </div>
  </section>
</BaseLayout>
