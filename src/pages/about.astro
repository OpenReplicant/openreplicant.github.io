---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Open Replicant">
  <section class="hero">
    <h1>About</h1>
    <p>
      This site is built with Astro: HTML partials are Astro components, and
      interactive widgets are Alpine.js islands that hydrate independently.
      Everything renders to static HTML for GitHub Pages.
    </p>
  </section>
</BaseLayout>
