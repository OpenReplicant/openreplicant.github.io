---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Services | Open Replicant">
  <section class="hero">
    <div class="hero__content">
      <h1>Consulting &amp; implementation</h1>
      <p class="hero__tagline">
        We help teams adopt and deploy Morphogen in production. From system
        mapping and knowledge-kernel setup through rollout and ongoing support,
        we make self-managing infrastructure work for your business.
      </p>
    </div>
  </section>

  <section class="section">
    <h2>What we offer</h2>
    <div class="grid">
      <article class="card">
        <span class="card__accent" aria-hidden="true"></span>
        <h3>AI strategy &amp; adoption</h3>
        <p>
          Assess where Morphogen fits in your infrastructure. Define which
          systems to describe first. Build a rollout plan tailored to your
          team's review lane and risk tolerance.
        </p>
      </article>
      <article class="card">
        <span class="card__accent" aria-hidden="true"></span>
        <h3>System mapping</h3>
        <p>
          We run the design agent with you — an interview becomes a system map,
          gaps become questions, and a complete map becomes a deployable compose
          file you approve before anything runs.
        </p>
      </article>
      <article class="card">
        <span class="card__accent" aria-hidden="true"></span>
        <h3>Implementation</h3>
        <p>
          We deploy and configure Morphogen on your infrastructure, integrate it
          with your systems, and hand it over ready to run — governed, with
          people in the loop.
        </p>
      </article>
      <article class="card">
        <span class="card__accent" aria-hidden="true"></span>
        <h3>Training &amp; enablement</h3>
        <p>
          Hands-on workshops so your engineers can operate, extend, and maintain
          Morphogen — writing providers, running the loop, and reviewing plans
          in the UI.
        </p>
      </article>
      <article class="card">
        <span class="card__accent" aria-hidden="true"></span>
        <h3>Production support</h3>
        <p>
          Ongoing support and maintenance for teams running Morphogen in
          production, including upgrades, incident response, and contract
          conformance against the kernel's 70+ test cases.
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="btn-row">
      <a href="mailto:services@openreplicant.example" class="btn btn--large">Contact us</a>
    </div>
  </section>
</BaseLayout>
